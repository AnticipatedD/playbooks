# ==============================================================================
# AMD Playbooks Monorepo Environment Configuration Template
# ==============================================================================

# GitHub Integration Tokens
# Used by the Next.js dashboard engine to poll runner registration APIs
DASHBOARD_GITHUB_TOKEN=ghp_yourDashboardTokenPlaceholder
# Used by Python validation and CI automation orchestration flows
GITHUB_TOKEN=ghp_yourAutomationTokenPlaceholder

# Orchestration & Pipeline Triggers
ORCHESTRAI_PIPELINE_TOKEN=token_orchestrai_pipeline_secret
ORCHESTRAI_API_BASE_URL=https://amd.com

# Translation Services & Localization Tooling Keys
LEMONADE_API_KEY=key_lemonade_translation_service_secret
LEMONADE_PROJECT_ID=proj_playbooks_localization

# Playbook Validation Engine Variables
PLAYBOOK_VALIDATION_STRICT=true
PLAYBOOK_SCHEMA_PATH=../playbooks/schema.json

# Infrastructure Orchestration Runtime Envs
CI_ORCHESTRATION_ENV=development
LOG_LEVEL_OVERRIDE=INFO
