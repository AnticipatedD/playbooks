# ==============================================================================
# Next.js Dashboard Frontend Environment Configuration Template
# ==============================================================================

# GitHub API Access Token
# Required server-side to populate the self-hosted build cluster matrix tracking layout.
# Permissions checklist: Read-only access to 'Administration' on amd/playbooks
DASHBOARD_GITHUB_TOKEN=ghp_yourDashboardTokenPlaceholder

# Next.js Application Settings
# Explicit port maps or domain routes consumed by network handlers during runtime
NEXT_PUBLIC_APP_ENV=production
